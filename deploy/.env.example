# Copy to .env on the server (never commit .env) and fill every value.
DOMAIN=example.com

DB_DATABASE=mycovision
DB_USERNAME=myco
# openssl rand -hex 16
DB_PASSWORD=
DB_ROOT_PASSWORD=

# NEW key for production, do not reuse your local one:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# openssl rand -hex 24
RETRAIN_API_KEY=

# Google OAuth (add https://app.<DOMAIN> as an authorized JavaScript origin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# PayMongo (update redirect/webhook URLs to the new domains)
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
